# Copy to .env and fill in.

# The domain that will serve the map (point its DNS A record at this server first).
# Caddy gets a free HTTPS certificate for it automatically.
MAP_DOMAIN=maps.caliphaterides.ng

# Area to build: Sokoto State with a small margin (west,south,east,north).
BBOX=3.9,11.4,7.0,14.0

# OpenStreetMap data for Nigeria (updated daily by Geofabrik).
OSM_URL=https://download.geofabrik.de/africa/nigeria-latest.osm.pbf

# Place-search data: the Nigeria JSON dump from GraphHopper's Photon export server.
# Open https://download1.graphhopper.com/public/africa/nigeria/index.html and copy the link to
# the newest photon-dump-*.jsonl.zst file that matches PHOTON_VERSION below.
PHOTON_DUMP_URL=
PHOTON_VERSION=1.3.0
